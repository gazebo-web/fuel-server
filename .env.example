# fuel-server environment for local development.
#
# Copy this file to `.env` (or `.env.bash`) and source it before running:
#
#   set -a; source .env; set +a
#   go build && ./fuel-server
#
# Or, if you prefer the fuel-server convention:
#
#   source .env.bash   (after renaming and prefixing each line with `export `)

# ── Database (MySQL/MariaDB) ──────────────────────────────────
# Spin one up via:
#   docker run -d --name fuel-mysql \
#     -e MYSQL_ROOT_PASSWORD=fuelpass -e MYSQL_DATABASE=fuel \
#     -e MYSQL_USER=fuel -e MYSQL_PASSWORD=fuelpass \
#     -p 3306:3306 mysql:8
IGN_DB_USERNAME=fuel
IGN_DB_PASSWORD=fuelpass
IGN_DB_ADDRESS=localhost:3306
IGN_DB_NAME=fuel
IGN_DB_MAX_OPEN_CONNS=66

# ── Resource storage ──────────────────────────────────────────
# Directory where model/world/collection files are stored on disk.
# Will be created on first use; keep it outside /tmp if you want it to
# survive reboots.
IGN_FUEL_RESOURCE_DIR=/tmp/fuel

# ── Admin ─────────────────────────────────────────────────────
# Email of the system administrator. Any user whose Auth0 email matches
# this value gains system-admin privileges on login.
IGN_FUEL_SYSTEM_ADMIN=sys_admin@email.org

# ── Logging ───────────────────────────────────────────────────
# 0 = critical, 1 = +error, 2 = +warning (default), 3 = +info, 4 = +debug
IGN_FUEL_VERBOSITY=3

# ── Auth0 ─────────────────────────────────────────────────────
# RSA256 public key for verifying Auth0 JWTs. The frontend is currently
# using gazebosim-staging.us.auth0.com, so use that tenant's key here for
# local dev.
#
# To fetch: curl https://gazebosim-staging.us.auth0.com/.well-known/jwks.json
# Take the `x5c[0]` value of the active signing key.
#
# Paste a single line (no BEGIN/END markers). Leaving this unset makes the
# server start but reject every authenticated request.
AUTH0_RSA256_PUBLIC_KEY=

# ── Memcached (optional) ──────────────────────────────────────
# If unset, fuel-server logs a warning and skips caching.
# GZ_FUEL_MEMCACHED_ADDR=localhost:11211

# ── Elasticsearch (optional) ──────────────────────────────────
# If unset, search falls back to SQL.
# (Configured via the admin API once the server is running.)

# ── S3 ────────────────────────────────────────────────────────
# Fuel-server stores resources on S3. For local dev, set
# IGN_DEV_USE_FAKE_S3=true to spin up an in-process gofakes3 server
# (no AWS credentials required):
IGN_DEV_USE_FAKE_S3=true
#
# Or, if you want to talk to a real AWS bucket:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket
# AWS_BUCKET_PREFIX=

# ── Migration flags (leave off for local dev) ────────────────
# IGN_FUEL_MIGRATE_CASBIN=true
# IGN_FUEL_MIGRATE_UNIQUEOWNERS_TABLE=true
# IGN_FUEL_MIGRATE_MODEL_REPOSITORIES=true
# IGN_FUEL_MIGRATE_RESET_LIKE_AND_DOWNLOADS=true
# IGN_FUEL_MIGRATE_RESET_ZIP_FILESIZE=true
# IGN_FUEL_PARSE_WORLD_MODEL_INCLUDES=true

# ── SSL (only if you want HTTPS locally; HTTP on :8000 is the default) ─
# IGN_SSL_CERT=./ssl/cert.pem
# IGN_SSL_KEY=./ssl/key.pem

# ── AI tools (MCP endpoint + AI Builder agent) ───────────────
# Hosts whose Fuel model URIs (<include><uri>) are checked against this
# server's database during SDF validation. The first is also the host in
# include URIs for this server's own assets. Leave empty for local dev with
# an empty catalog; set to fuel.gazebosim.org in production.
# AI_TOOLS_FUEL_HOSTS=fuel.gazebosim.org
# A public Fuel server whose catalog the fuel_* tools search after this
# server's own, so local dev and staging see real models. Leave unset in
# production, where this server is the public catalog.
AI_TOOLS_UPSTREAM_FUEL=https://fuel.gazebosim.org
